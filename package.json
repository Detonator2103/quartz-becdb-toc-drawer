{
  "name": "quartz-toc-drawer",
  "version": "1.0.0",
  "description": "Mobile table-of-contents drawer for Quartz 5, opened and closed with the reader mode button",
  "type": "module",
  "license": "MIT",
  "author": "Deto",
  "repository": {
    "type": "git",
    "url": "https://github.com/YOUR_GITHUB_NAME/quartz-toc-drawer"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "table-of-contents",
    "mobile",
    "component"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --max-warnings=0",
    "format": "prettier . --check",
    "test": "tsup && vitest run",
    "typecheck": "tsc --noEmit",
    "check": "npm run typecheck && npm run lint && npm run format && npm run test",
    "prepublishOnly": "npm run build"
  },
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/types": "^1.0.0",
    "@quartz-community/utils": "^1.0.0"
  },
  "devDependencies": {
    "@types/hast": "^3.0.4",
    "@types/jsdom": "^30.0.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "jsdom": "^30.1.3",
    "preact": "^10.28.2",
    "preact-render-to-string": "^6.8.2",
    "prettier": "^3.6.2",
    "sass": "^1.97.3",
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "vfile": "^6.0.3",
    "vitest": "^2.1.9"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "toc-drawer",
    "displayName": "TOC Drawer (mobile)",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "optionSchema": {
      "title": {
        "type": "string"
      }
    },
    "components": {
      "TocDrawer": {
        "displayName": "TOC Drawer",
        "defaultPosition": "left",
        "defaultPriority": 40
      }
    }
  }
}
